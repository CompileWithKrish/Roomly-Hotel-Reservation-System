# ====================================================================
# Roomly - Git Ignore Rules
# ====================================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Preserve template files
!.env.example
!frontend/.env.example

# Build Artifacts - Backend (Java / Maven)
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar

# Build Artifacts - Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/*.tsbuildinfo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# IDE & Editor Files
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.log

# Docker Local Mounts
docker-data/
postgres_data/
