# ====================================================================
# Roomly Environment Variables Template (.env.example)
# Copy to .env for local development or configure in Render Dashboard
# NEVER commit actual secrets, passwords, or private keys to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. Backend Service Configuration (Render Web Service)
# --------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Connection (Render PostgreSQL)
# Render Internal Database URL: jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roomly_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password

# JWT Authentication
# Generate a strong 256-bit hexadecimal or Base64 secret in production
JWT_SECRET=your_production_256_bit_jwt_secret_must_be_kept_confidential
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g., your Render Static Site URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-roomly-frontend.onrender.com

# --------------------------------------------------------------------
# 2. Frontend Configuration (Render Static Site)
# --------------------------------------------------------------------
VITE_APP_TITLE=Roomly Hotel Management
# Must point to your backend /api/v1 endpoint (no trailing slash)
VITE_API_BASE_URL=https://your-roomly-backend.onrender.com/api/v1
